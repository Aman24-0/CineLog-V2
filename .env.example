# CineLog V2 — Environment Variables
#
# These must be set in the Vercel dashboard (Settings → Environment Variables)
# or in a local .env file for development.
#
# VITE_ prefix = exposed to the client (Vite handles this).

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# TMDB API (movie/TV metadata)
VITE_TMDB_API_KEY=

# OMDb API (ratings)
VITE_OMDB_API_KEY=
