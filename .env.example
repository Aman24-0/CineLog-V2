# CineLog V2 — Environment Variables
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# For production, set these in the Vercel dashboard:
#   Settings → Environment Variables
#
# ──────────────────────────────────────────────────────────────────────
# SECURITY MODEL
# ──────────────────────────────────────────────────────────────────────
# All PUBLIC variables use the `VITE_` prefix, which Vite exposes to the
# client-side bundle. This is intentional — these are all PUBLIC,
# read-only keys designed by their providers to be shipped to browsers:
#
#   • Supabase ANON key — safe to expose. RLS policies enforce row-level
#     security; the anon key cannot bypass them. The Supabase SERVICE
#     ROLE key is NEVER used in the application runtime and must NEVER
#     be added here. It is reserved for trusted admin scripts (DB
#     migrations) and Supabase Edge Functions only.
#
#   • TMDB API key — TMDB's v3 API key is a read-only key meant for
#     client-side use. Rate limits apply per-key.
#
#   • OMDb API key — free, read-only, rate-limited. Safe to expose.
#
#   If you need a server-side secret (e.g. for webhooks, service-role
#   operations, or third-party APIs that require a private key), do NOT
#   use the `VITE_` prefix — use a plain name (e.g. `STRIPE_SECRET_KEY`)
#   so Vite keeps it server-only.
#
#   • TMDB_API_KEY — used by the server-side /api/media/* proxy to
#     inject the TMDB API key into upstream requests. This is the
#     RECOMMENDED way to configure TMDB access — the key is NEVER
#     exposed to the browser (no VITE_ prefix). Falls back to
#     VITE_TMDB_API_KEY if TMDB_API_KEY is not set.
#
#   • SUPABASE_SERVICE_ROLE_KEY — used ONLY by server API routes
#     (/api/tmdb-cache, /api/admin/*) to bypass RLS for shared
#     metadata and admin operations. NEVER exposed to the browser
#     (no VITE_ prefix).
# ──────────────────────────────────────────────────────────────────────

# Supabase (https://app.supabase.com → Your Project → Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Service Role Key — SERVER-ONLY, never expose to the browser!
# Used by /api/tmdb-cache route to read/write the tmdb_cache table.
# Find it at: Supabase Dashboard → Settings → API → service_role key (secret)
SUPABASE_SERVICE_ROLE_KEY=

# TMDB API (https://www.themoviedb.org/settings/api → API Key)
# TMDB_API_KEY — server-only, never exposed to browser. Used by /api/media/* proxy.
# This is the RECOMMENDED way to configure TMDB access. Falls back to
# VITE_TMDB_API_KEY if TMDB_API_KEY is not set.
TMDB_API_KEY=
# VITE_TMDB_API_KEY — legacy client-side key (still works, but exposed in browser bundle).
# Kept for backward compatibility during migration. Set TMDB_API_KEY instead if possible.
VITE_TMDB_API_KEY=

# OMDb API (https://www.omdbapi.com/apikey.aspx)
VITE_OMDB_API_KEY=

# MDBList API (https://mdblist.com/preferences → API Key)
# SERVER-ONLY — never expose to the browser (no VITE_ prefix).
# Used by /api/media/ratings route to fetch IMDb / Rotten Tomatoes /
# Metacritic ratings WITH vote counts for the 3-column rating panel in
# the Details modal. MDBList aggregates all three services into one
# response, so we don't need separate API keys for each.
MDBLIST_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# ADMIN PANEL (Phase 1+)
# ──────────────────────────────────────────────────────────────────────
# These variables enable the /admin routes. They are SERVER-ONLY —
# no VITE_ prefix. If any of them is missing, /admin/login will fail.
#
# ADMIN_PIN — the 6-digit PIN required for admin login (Layer 3 of auth).
#   Set this to any 6-digit string. Change it any time by updating the
#   env var (no DB change needed).
#
# ADMIN_JWT_SECRET — signs the admin session cookie. Generate a 32+ char
#   random string. If this changes, all active admin sessions are
#   invalidated (admins must re-login).
#
# SUPABASE_ACCESS_TOKEN — used by the admin dashboard to fetch database
#   size metrics from the Supabase Management API. Optional — if missing,
#   the "Database Size" metric shows "—".
#   Get it at: Supabase Dashboard → Account → Access Tokens
ADMIN_PIN=
ADMIN_JWT_SECRET=
SUPABASE_ACCESS_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# ANILIST API (Anime enrichment — Phase 0)
# ──────────────────────────────────────────────────────────────────────
# AniList GraphQL endpoint. Always points to the public GraphQL API.
# No API key required for anonymous read-only queries (rate-limited
# to 90 requests/min per IP). Set ANILIST_ACCESS_TOKEN only if you
# have a personal AniList account token (raises the limit to 120/min
# and unlocks user-specific fields we don't currently use).
ANILIST_API_URL=https://graphql.anilist.co
ANILIST_ACCESS_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# WEB PUSH (Phase 2 — Task 13: Background push notifications)
# ──────────────────────────────────────────────────────────────────────
# VAPID keys are used by the /api/push/send serverless function to
# sign Web Push messages. The browser uses the PUBLIC key to
# subscribe via PushManager.subscribe({ applicationServerKey });
# the server uses the PRIVATE key to sign every outgoing push.
#
# BOTH keys are SERVER-ONLY (no VITE_ prefix) — even though the
# public key is "public" in the cryptographic sense, we don't want
# it in the client bundle. Instead, the browser fetches it at runtime
# from the `app_config` table (key = 'vapid_public_key'), which is
# populated by an admin after generating the keys here.
#
# HOW TO GENERATE:
#   npx web-push generate-vapid-keys --json
# Copy the publicKey and privateKey into the two vars below.
#
# THEN SET THE PUBLIC KEY IN THE DATABASE:
#   After your first deploy, run this SQL against your Supabase
#   project (Dashboard → SQL Editor):
#
#     UPDATE app_config
#     SET value = to_jsonb('<paste-public-key-here>'::text)
#     WHERE key = 'vapid_public_key';
#
#   (The migration 20260802_add_push_subscriptions.sql inserts an
#   empty-string placeholder row so the UPDATE above works without
#   an INSERT.)
#
# OPTIONAL — VAPID_CONTACT_EMAIL:
#   The "mailto:" contact the Web Push spec requires. Defaults to
#   "mailto:admin@cinelog.app" if unset. Set this to a real address
#   so push services can contact you about delivery issues.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# ──────────────────────────────────────────────────────────────────────
# EMAIL NOTIFICATIONS (Phase 2 — Task 15: Email fallback channel)
# ──────────────────────────────────────────────────────────────────────
# Resend (https://resend.com) is the email delivery provider. When
# push delivery fails (no subscription, push service unreachable) OR
# the user has push disabled but email enabled, the system sends an
# email via Resend instead.
#
# RESEND_API_KEY — SERVER-ONLY (no VITE_ prefix). Used by
#   /api/email/send to authenticate with Resend's API. Get one at:
#   https://resend.com/api-keys
#
# RESEND_FROM_EMAIL — SERVER-ONLY. The "From" address on every
#   outgoing email. Resend's free tier only allows sending FROM
#   onboarding@resend.dev (their shared test domain). To send from
#   your own domain, verify it in the Resend dashboard first.
#   Default: onboarding@resend.dev
#
# MOCK MODE:
#   If RESEND_API_KEY is not set, /api/email/send logs the email to
#   the server console and returns success — this lets the full
#   notification flow work end-to-end in dev without a Resend account.
#   The mock mode is automatic; no flag needs to be set.
#
# RATE LIMITING:
#   /api/email/send enforces a per-user rate limit of 10 emails/day
#   (in-memory, resets on server restart). This protects against
#   runaway callers. The weekly-recap cron bypasses the rate limit
#   (it sends at most one email per week per user, authenticated via
#   CRON_SECRET).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ──────────────────────────────────────────────────────────────────────
# CRON_SECRET — shared secret for cron-invoked serverless routes
# ──────────────────────────────────────────────────────────────────────
#
# Used by:
#   • /api/cron/weekly-recap  — invoked by pg_cron every Monday 09:00 UTC
#   • /api/push/send-admin    — invoked by the weekly recap route to
#     deliver push notifications to users (no user session available)
#   • /api/email/send         — Phase 2 Task 15: the weekly recap
#     route uses CRON_SECRET to call /api/email/send as a fallback
#     when push delivery fails for a user. The cron path bypasses
#     the user-session auth and the per-user rate limit.
#
# The cron job sends this secret in the `X-Cron-Secret` header. The
# serverless route compares it (constant-time) to this env var.
#
# Generate with: openssl rand -hex 32
#
# After setting this, update the pg_cron job's URL in the migration
# (20260803_add_weekly_recap_preferences.sql) to include the secret in
# the X-Cron-Secret header — OR run the weekly recap via Vercel Cron
# instead (see the migration comments for both options).
CRON_SECRET=

# ──────────────────────────────────────────────────────────────────────
# SENTRY (Phase 8 — Error monitoring)
# ──────────────────────────────────────────────────────────────────────
# Sentry DSNs for error monitoring. The client DSN is exposed to the
# browser bundle (VITE_ prefix); the server DSN is server-only.
#
# Both are OPTIONAL — if unset, the Sentry wrappers (src/lib/sentry/)
# short-circuit into no-ops and fall back to console.error. This keeps
# the app fully functional in dev + on self-hosted instances that don't
# want to set up a Sentry project.
#
# HOW TO GET A DSN:
#   1. Sign up at https://sentry.io (free tier covers 5K errors/month).
#   2. Create a new project — pick "SolidJS" / "Node" platform.
#   3. Copy the DSN from Project Settings → Client Keys.
#
# CLIENT (VITE_SENTRY_DSN):
#   - Used by src/lib/sentry/client.ts to init @sentry/browser.
#   - Captures client-side errors: uncaught exceptions, unhandled
#     promise rejections, captureException() calls from React/Solid
#     error boundaries.
#   - Replay integration is enabled with maskAllText=true to protect
#     user PII in session replays.
#   - Auto-strips ResizeObserver loop + TMDB 401 noise via beforeSend.
#
# SERVER (SENTRY_DSN):
#   - Used by src/lib/sentry/server.ts to init @sentry/node.
#   - Captures server-side errors: unhandled rejections in entry-server,
#     captureException() calls from API routes.
#   - Initializes at module load (top-level side effect) so the
#     OpenTelemetry instrumentation hooks are in place before any
#     request handler runs.
#   - TMDB-suppression logic from entry-server.tsx is preserved in
#     the server beforeSend so TMDB API errors don't spam Sentry.
VITE_SENTRY_DSN=
SENTRY_DSN=

# ──────────────────────────────────────────────────────────────────────
# TRAKT API (Phase 12 — Data Sync Hardening)
# ──────────────────────────────────────────────────────────────────────
# Trakt OAuth credentials for the Direct API Integration.
# Register your app at https://trakt.tv/oauth/applications (use the
# "API Apps" section in your Trakt account settings).
#
# ALL THREE variables are SERVER-ONLY (no VITE_ prefix). The client_id
# is technically safe to expose (it's a public OAuth identifier), but
# we keep it server-side so the browser bundle doesn't know which Trakt
# app we're using until the user actually clicks "Connect Trakt".
# The client_secret MUST NEVER reach the browser — anyone with the
# secret can impersonate the CineLog Trakt app.
#
# TRAKT_CLIENT_ID — the OAuth client_id from your Trakt app settings.
# TRAKT_CLIENT_SECRET — the OAuth client_secret. Server-only.
# TRAKT_REDIRECT_URI — the public URL Trakt redirects to after the user
#   authorizes. MUST match exactly what's in your Trakt app settings.
#   Example: https://cinelog.app/api/auth/trakt/callback
#   For local dev: http://localhost:3000/api/auth/trakt/callback
#
# VITE_TRAKT_CLIENT_ID — CLIENT-SIDE FEATURE FLAG. Set this to the SAME
#   value as TRAKT_CLIENT_ID. Its mere presence (non-empty string) is
#   what gates the "Direct integrations" UI in /settings/sync — when
#   this is empty/unset, the TraktIntegrationCard is NOT rendered, so
#   users never see a "Connect Trakt" button that would 500 on click.
#   The actual client_id value is safe to expose (it's already in the
#   OAuth authorize URL the server redirects to), but we don't read
#   this variable for anything other than the "is Trakt configured?"
#   UI gate. The server always reads TRAKT_CLIENT_ID (no VITE_ prefix).
#
# The OAuth flow:
#   1. Browser GETs /api/auth/trakt → server redirects to Trakt's
#      authorize page with the client_id + redirect_uri.
#   2. User signs in to Trakt + grants CineLog permission.
#   3. Trakt redirects to /api/auth/trakt/callback?code=...&state=...
#   4. Server exchanges the code for an access_token + refresh_token
#      (using the client_secret), fetches the user's Trakt profile to
#      verify the email matches their CineLog account, and stores the
#      tokens in the `user_integrations` table (RLS-protected, owner-only).
#   5. /api/sync/trakt/preview and /api/sync/trakt/execute read the
#      stored token to fetch the user's Trakt history and bulk-upsert
#      it into their CineLog vault.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=
# Client-side feature flag — set to the SAME value as TRAKT_CLIENT_ID.
# When unset/empty, the TraktIntegrationCard is hidden in /settings/sync.
VITE_TRAKT_CLIENT_ID=

