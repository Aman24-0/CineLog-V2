node_modules
.output
.netlify
.vercel
dist
.vinxi

# ── Environment files (never commit secrets) ──────────────────────────
# Covers all common .env variants so a future `.env.staging` or
# `.env.*.local` can never be accidentally committed.
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.staging
.env.staging.local
.env.test
.env.test.local
.env.production
.env.production.local

# ── Secret / credential files (preventive — none exist today) ────────
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
.envrc
.tool-versions

# ── Local tool credentials ────────────────────────────────────────────
.npmrc
.netrc
.ssh/
.aws/
.gcloud/

# ── Editor / OS metadata ──────────────────────────────────────────────
.vscode
.idea
.DS_Store
Thumbs.db

# ── Supabase CLI ──────────────────────────────────────────────────────
.supabase/
supabase/.branches
supabase/.temp

# ── Build / cache artifacts ───────────────────────────────────────────
.cache
.turbo
.eslintcache
coverage
*.log
timestamp*
# Vinxi auto-generates app.config.timestamp_*.js during dev/build — never commit
app.config.timestamp_*

# ── Playwright E2E test artifacts ─────────────────────────────────────
# Test results, HTML reports, screenshots, videos, and traces are
# generated on test runs and should never be committed.
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/
/playwright/.auth/

# ── AI agent working files (not part of the app) ─────────────────────
agent-ctx/
